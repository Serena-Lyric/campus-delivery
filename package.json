{
  "name": "campus-delivery",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "pnpm --filter @campus-delivery/api build",
    "dev": "pnpm --filter @campus-delivery/api dev",
    "start": "pnpm --filter @campus-delivery/api start",
    "db:generate": "pnpm --filter @campus-delivery/api db:generate",
    "db:migrate": "pnpm --filter @campus-delivery/api db:migrate",
    "db:seed": "pnpm --filter @campus-delivery/api db:seed",
    "test": "pnpm --filter @campus-delivery/api test",
    "test:integration": "pnpm --filter @campus-delivery/api test:integration",
    "typecheck": "pnpm --filter @campus-delivery/api typecheck"
  }
}
