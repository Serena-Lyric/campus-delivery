generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  MERCHANT
  RIDER
  ADMIN
}

enum AdminLevel {
  OPERATOR
  SUPER_ADMIN
}

enum CampusLocationType {
  GATE
  MERCHANT
  CANTEEN
  DORMITORY
  TEACHING_BUILDING
  OTHER
}

enum MerchantExposureState {
  TRIAL
  NORMAL
  REDUCED
  LIMITED
  SEVERELY_LIMITED
  HIDDEN
  SUSPENDED
}

enum MerchantTimeRisk {
  UNKNOWN
  NORMAL
  SLOW
}

enum MerchantCompletionRisk {
  UNKNOWN
  NORMAL
  ELEVATED
  HIGH
}

enum RiderStatus {
  OFFLINE
  AVAILABLE
  SUSPENDED
}

enum RiderCapacityStage {
  TUTORIAL
  FIRST_DELIVERY_SAME_DAY
  STANDARD
}

enum RiderCapacityEventType {
  FIRST_DELIVERY_UPGRADE
  NEXT_DAY_UPGRADE
  ADMIN_OVERRIDE_SET
  ADMIN_OVERRIDE_CLEARED
}

enum FoodType {
  DRINK
  RICE_MEAL
  NOODLE
  SOUP
  CAKE_DESSERT
  OTHER
  UNKNOWN
}

enum DeliveryMethod {
  DESIGNATED_POINT
  DOOR
  FACE_TO_FACE
}

enum DeliveryVerificationMode {
  DELIVERY_PHOTO
  HANDOFF_CODE
}

enum PickupVerificationMode {
  CONFIRMATION
  PHOTO
  PICKUP_CODE
}

enum OrderStatus {
  CREATED
  MERCHANT_PENDING
  MERCHANT_CONFIRMED
  READY_FOR_RIDER
  CLAIMED
  PICKED_UP
  DELIVERED
  NO_RIDER_ACCEPTED
  CANCELLED
  EXCEPTION
}

enum OrderEventType {
  ORDER_CREATED
  COOLING_OFF_COMPLETED
  MERCHANT_CONFIRMED
  READY_FOR_RIDER
  RIDER_CLAIMED
  RIDER_ABANDONED
  RIDER_PRE_PICKUP_CANCELLED
  MERCHANT_QUOTE_UPDATED
  RIDER_TIP_UPDATED
  PLATFORM_SUBSIDY_ADDED
  MERCHANT_PREPARATION_UPDATED
  NO_RIDER_ACCEPTED
  PICKED_UP
  DELIVERED
  CANCELLED
  EXCEPTION_RECORDED
  STATUS_CHANGED
}

enum OrderEventActorType {
  USER
  SYSTEM
}

enum DeliveryTaskStatus {
  OPEN
  CLAIMED
  PICKED_UP
  COMPLETED
  NO_RIDER_ACCEPTED
  CANCELLED
  EXCEPTION
}

enum MerchantPreparationStatus {
  PREPARING
  READY_FOR_PICKUP
}

enum ClaimSampleType {
  NATURAL
  SUBSIDIZED
}

enum RiderTipEventType {
  PRE_CLAIM_ADJUSTMENT
  POST_CLAIM_ADDITION
  NO_RIDER_REFUND
  ORDER_CANCELLATION_REFUND
}

enum DeliveryAssignmentStatus {
  ACTIVE
  ABANDONED
  COMPLETED
  EXCEPTION
}

enum SettlementStatus {
  PENDING
  FINALIZED
}

enum RiderSettlementStatus {
  PENDING
  AVAILABLE
  HELD
}

enum VerificationPurpose {
  DELIVERY
  PICKUP
}

enum EvidenceType {
  MERCHANT_HANDOFF_PHOTO
  RIDER_PICKUP_PHOTO
  DELIVERY_PHOTO
  HANDOFF_CODE_VERIFICATION
  PICKUP_CODE_VERIFICATION
}

enum ExceptionType {
  CUSTOMER_UNREACHABLE
  WRONG_ADDRESS
  MERCHANT_DELAY
  ITEM_MISSING
  ITEM_DAMAGED
  RIDER_DELIVERY_EXCEPTION
  DELIVERY_DISPUTE
  MINOR_DAMAGE_OR_DELAY
  SEVERE_FOOD_DAMAGE
  FOOD_LOST
  OTHER_NEEDS_REVIEW
}

enum RiderCancellationReason {
  PERSONAL_EMERGENCY
  VEHICLE_ISSUE
  OTHER
}

enum RiderRestrictionType {
  SAME_DAY_NEW_CLAIM_PAUSE
  ROLLING_CANCELLATION_COOLDOWN
  ROLLING_WARNING_COOLDOWN
  MANUAL
}

enum RiderRestrictionStatus {
  ACTIVE
  RELEASED
  OVERRIDDEN
}

enum RiderRestrictionSource {
  AUTOMATIC
  ADMIN
}

enum ExceptionCasePriority {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
}

enum ExceptionCaseStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_PARTICIPANT
  ESCALATED
  RESOLVED
  CLOSED
}

enum ExceptionResolutionType {
  REMAKE_AND_CONTINUE
  REFUND_AND_CLOSE
  WAITING_FOR_INFORMATION
  RESPONSIBILITY_UNDETERMINED
  CONTINUE_FULFILLMENT
  ESCALATED_OTHER
}

enum ExceptionCaseActionType {
  CREATED
  CLAIMED
  RELEASED
  TRANSFERRED
  TAKEN_OVER
  ESCALATED
  REQUESTED_INFORMATION
  RESOLVED
  CLASSIFIED
  REFUND_EXECUTED
  RESERVATION_RELEASED
}

enum RemakeProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum CompensationStatus {
  OPEN
  FUNDED
  PARTIALLY_FUNDED
  RESOLVED
}

enum CompensationFundingSource {
  CURRENT_ORDER_SETTLEMENT
  OTHER_UNWITHDRAWN_SETTLEMENT
  RIDER_VOLUNTARY_PAYMENT
  PLATFORM_ADVANCE
}

model User {
  id                        String                            @id @default(uuid()) @db.Uuid
  displayName               String
  role                      UserRole
  active                    Boolean                           @default(true)
  merchant                  Merchant?
  rider                     Rider?
  customerOrders            Order[]                           @relation("CustomerOrders")
  operatedEvents            OrderEvent[]                      @relation("OrderEventOperator")
  evidence                  Evidence[]
  reportedExceptions        ExceptionEvent[]                  @relation("ExceptionReporter")
  issuedCodes               VerificationCode[]                @relation("VerificationIssuer")
  verifiedCodes             VerificationCode[]                @relation("VerificationVerifier")
  merchantQuoteChanges      MerchantDeliveryQuote[]           @relation("MerchantQuoteOperator")
  riderTipEvents            RiderTipEvent[]                   @relation("RiderTipCustomer")
  configAudits              BusinessConfigAudit[]             @relation("BusinessConfigAuditActor")
  exposureDecisions         MerchantExposureDecision[]        @relation("MerchantExposureDecisionActor")
  adminProfile              AdminProfile?
  handledCases              ExceptionCase[]                   @relation("ExceptionCaseHandler")
  caseActions               ExceptionCaseAction[]             @relation("ExceptionCaseActionActor")
  previousCaseActions       ExceptionCaseAction[]             @relation("ExceptionCasePreviousHandler")
  nextCaseActions           ExceptionCaseAction[]             @relation("ExceptionCaseNextHandler")
  restrictionAudits         RiderRestrictionAudit[]           @relation("RiderRestrictionAuditActor")
  compensationActions       CompensationObligation[]          @relation("CompensationActor")
  adminProfileAudits        AdminProfileAudit[]               @relation("AdminProfileAuditActor")
  adminProfileChanges       AdminProfileAudit[]               @relation("AdminProfileAuditTarget")
  capacityEvents            RiderCapacityEvent[]              @relation("RiderCapacityEventActor")
  rescueContributionChanges MerchantRescueContributionEvent[]
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
}

model CampusLocation {
  id                       String             @id @default(uuid()) @db.Uuid
  name                     String
  type                     CampusLocationType
  description              String?
  regionLabel              String?
  supportedDeliveryMethods DeliveryMethod[]   @default([DESIGNATED_POINT, DOOR, FACE_TO_FACE])
  merchants                Merchant[]
  destinationOrders        Order[]
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
}

model Merchant {
  id                        String                     @id @default(uuid()) @db.Uuid
  ownerId                   String                     @unique @db.Uuid
  owner                     User                       @relation(fields: [ownerId], references: [id])
  name                      String
  description               String?
  campusLocationId          String                     @db.Uuid
  campusLocation            CampusLocation             @relation(fields: [campusLocationId], references: [id])
  isOpen                    Boolean                    @default(true)
  exposureState             MerchantExposureState      @default(TRIAL)
  trialExposureOverrideBps  Int?
  maxConcurrentOrders       Int                        @default(0)
  deliveryContributionMinor Int                        @default(0)
  baseDeliveryPriceMinor    Int                        @default(0)
  supportedDeliveryMethods  DeliveryMethod[]           @default([DESIGNATED_POINT, DOOR, FACE_TO_FACE])
  pickupVerificationMode    PickupVerificationMode     @default(CONFIRMATION)
  categories                ProductCategory[]
  products                  Product[]
  orders                    Order[]
  subsidyAccount            MerchantSubsidyAccount?
  subsidyRecords            SubsidyRecord[]
  exposureDecisions         MerchantExposureDecision[]
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
}

model ProductCategory {
  id         String    @id @default(uuid()) @db.Uuid
  merchantId String    @db.Uuid
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  sortOrder  Int       @default(0)
  products   Product[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([merchantId, name])
  @@index([merchantId, sortOrder])
}

model Product {
  id          String          @id @default(uuid()) @db.Uuid
  merchantId  String          @db.Uuid
  merchant    Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  categoryId  String          @db.Uuid
  category    ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  description String?
  priceMinor  Int
  isAvailable Boolean         @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([merchantId, isAvailable])
  @@index([categoryId])
}

model Rider {
  id                          String                   @id @default(uuid()) @db.Uuid
  userId                      String                   @unique @db.Uuid
  user                        User                     @relation(fields: [userId], references: [id])
  status                      RiderStatus              @default(OFFLINE)
  currentConcurrentOrderLimit Int                      @default(1)
  firstNormalDeliveredAt      DateTime?
  capacityOverride            Int?
  deliveryTasks               DeliveryTask[]
  assignments                 DeliveryAssignment[]
  settlements                 RiderSettlement[]
  cancellationEvents          RiderCancellationEvent[]
  restrictions                RiderRestriction[]
  compensationObligations     CompensationObligation[]
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  remakeProposals             RemakeProposal[]
  capacityEvents              RiderCapacityEvent[]
}

model Order {
  id                           String                            @id @default(uuid()) @db.Uuid
  shortCode                    String
  shortCodeDay                 DateTime                          @db.Date
  coolingOffEndsAt             DateTime
  tipDeadline                  DateTime
  customerId                   String                            @db.Uuid
  customer                     User                              @relation("CustomerOrders", fields: [customerId], references: [id])
  merchantId                   String                            @db.Uuid
  merchant                     Merchant                          @relation(fields: [merchantId], references: [id])
  destinationLocationId        String                            @db.Uuid
  destinationLocation          CampusLocation                    @relation(fields: [destinationLocationId], references: [id])
  destinationLabelSnapshot     String
  destinationRegionSnapshot    String?
  pickupMerchantNameSnapshot   String
  pickupLocationNameSnapshot   String
  pickupRegionSnapshot         String?
  deliveryMethod               DeliveryMethod
  deliveryVerificationMode     DeliveryVerificationMode
  pickupVerificationMode       PickupVerificationMode
  deliveryEvidenceRequired     Boolean                           @default(false)
  merchantPreparationStatus    MerchantPreparationStatus         @default(PREPARING)
  merchantPreparationUpdatedAt DateTime?
  status                       OrderStatus                       @default(CREATED)
  items                        OrderItem[]
  events                       OrderEvent[]
  deliveryTask                 DeliveryTask?
  pricing                      OrderPricing?
  settlement                   Settlement?
  riderSettlement              RiderSettlement?
  subsidyRecords               SubsidyRecord[]
  evidences                    Evidence[]
  exceptions                   ExceptionEvent[]
  verificationCodes            VerificationCode[]
  assignments                  DeliveryAssignment[]
  merchantQuoteHistory         MerchantDeliveryQuote[]
  riderTipEvents               RiderTipEvent[]
  exceptionCases               ExceptionCase[]
  remakeProposals              RemakeProposal[]
  compensationObligations      CompensationObligation[]
  rescueContributionEvents     MerchantRescueContributionEvent[]
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  riderCancellationEvents      RiderCancellationEvent[]

  @@unique([shortCodeDay, shortCode])
  @@index([customerId, createdAt])
  @@index([merchantId, status])
  @@index([status, coolingOffEndsAt])
}

model OrderItem {
  id                           String   @id @default(uuid()) @db.Uuid
  orderId                      String   @db.Uuid
  order                        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId                    String   @db.Uuid
  product                      Product  @relation(fields: [productId], references: [id])
  productNameSnapshot          String
  merchantCategoryNameSnapshot String
  suggestedFoodType            FoodType
  handlingTags                 String[] @default([])
  classificationSource         String
  classificationVersion        String
  classificationConfidenceBps  Int
  unitPriceMinor               Int
  quantity                     Int
  subtotalMinor                Int

  @@index([orderId])
}

model OrderEvent {
  id           String              @id @default(uuid()) @db.Uuid
  orderId      String              @db.Uuid
  order        Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  eventType    OrderEventType      @default(STATUS_CHANGED)
  actorType    OrderEventActorType @default(USER)
  fromStatus   OrderStatus?
  toStatus     OrderStatus
  operatorId   String?             @db.Uuid
  operator     User?               @relation("OrderEventOperator", fields: [operatorId], references: [id])
  operatorRole UserRole?
  reason       String?
  metadata     Json?
  createdAt    DateTime            @default(now())

  @@index([orderId, createdAt])
}

model DeliveryTask {
  id                             String                   @id @default(uuid()) @db.Uuid
  orderId                        String                   @unique @db.Uuid
  order                          Order                    @relation(fields: [orderId], references: [id])
  status                         DeliveryTaskStatus       @default(OPEN)
  riderId                        String?                  @db.Uuid
  rider                          Rider?                   @relation(fields: [riderId], references: [id])
  payoutMinor                    Int
  claimedAt                      DateTime?
  pickedUpAt                     DateTime?
  deliveredAt                    DateTime?
  firstPublishedAt               DateTime?
  claimDeadline                  DateTime?
  finalUserWarningAt             DateTime?
  marketPolicyVersion            Int?
  merchantRepriceCooldownSeconds Int?
  riderSettlementPendingSeconds  Int?
  assignments                    DeliveryAssignment[]
  cancellationEvents             RiderCancellationEvent[]
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt

  @@index([status, createdAt])
  @@index([riderId, status])
}

model DeliveryAssignment {
  id                                       String                   @id @default(uuid()) @db.Uuid
  taskId                                   String                   @db.Uuid
  task                                     DeliveryTask             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orderId                                  String                   @db.Uuid
  order                                    Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId                                  String                   @db.Uuid
  rider                                    Rider                    @relation(fields: [riderId], references: [id])
  status                                   DeliveryAssignmentStatus @default(ACTIVE)
  claimedAt                                DateTime                 @default(now())
  endedAt                                  DateTime?
  reason                                   String?
  merchantQuoteMinorAtClaim                Int
  customerTipMinorAtClaim                  Int
  platformSubsidyMinorAtClaim              Int
  riderPayoutMinorAtClaim                  Int
  riderGuaranteedPayoutMinorAtClaim        Int
  customerDeliveryFeeMinorAtClaim          Int
  riderBasePayoutMinorAtClaim              Int
  merchantRescueContributionMinorAtClaim   Int
  deliveryPlatformContributionMinorAtClaim Int
  pricingPolicyVersionAtClaim              Int
  pricingInputsSnapshotAtClaim             Json
  postClaimTipMinor                        Int                      @default(0)
  quoteVersionAtClaim                      Int
  claimSampleType                          ClaimSampleType
  claimLatencySeconds                      Int
  tipEvents                                RiderTipEvent[]
  cancellationEvents                       RiderCancellationEvent[]
  createdAt                                DateTime                 @default(now())
  updatedAt                                DateTime                 @updatedAt

  @@index([riderId, status])
  @@index([taskId, status])
  @@index([orderId, createdAt])
}

model OrderPricing {
  id                                String    @id @default(uuid()) @db.Uuid
  orderId                           String    @unique @db.Uuid
  order                             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemSubtotalMinor                 Int
  customerDeliveryFeeMinor          Int       @default(0)
  merchantDeliveryContributionMinor Int       @default(0)
  merchantBaseDeliveryPriceMinor    Int       @default(0)
  riderBasePayoutMinor              Int       @default(0)
  merchantRescueContributionMinor   Int       @default(0)
  customerRiderTipMinor             Int       @default(0)
  customerRiderTipRefundMinor       Int       @default(0)
  platformSubsidyMinor              Int       @default(0)
  riderPayoutMinor                  Int       @default(0)
  riderGuaranteedPayoutMinor        Int       @default(0)
  deliveryPlatformContributionMinor Int       @default(0)
  pricingPolicyVersion              Int       @default(0)
  pricingInputsSnapshot             Json?
  pricingReason                     String?
  merchantRescueContributionVersion Int       @default(0)
  merchantRescueUpdatedAt           DateTime?
  merchantQuoteVersion              Int       @default(0)
  merchantQuoteUpdatedAt            DateTime?
  platformCommissionMinor           Int       @default(0)
  merchantSettlementMinor           Int       @default(0)
  customerRefundMinor               Int       @default(0)
  exceptionCompensationMinor        Int       @default(0)
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt
}

model RiderCapacityEvent {
  id               String                 @id @default(uuid()) @db.Uuid
  riderId          String                 @db.Uuid
  rider            Rider                  @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type             RiderCapacityEventType
  stage            RiderCapacityStage
  previousCapacity Int
  newCapacity      Int
  actorId          String?                @db.Uuid
  actor            User?                  @relation("RiderCapacityEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  reason           String
  stageEventKey    String?                @unique
  metadata         Json?
  createdAt        DateTime               @default(now())

  @@index([riderId, createdAt])
}

model MerchantRescueContributionEvent {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version       Int
  previousMinor Int
  addedMinor    Int
  newMinor      Int
  operatorId    String   @db.Uuid
  operator      User     @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([orderId, version])
  @@index([orderId, createdAt])
}

model Settlement {
  id                   String           @id @default(uuid()) @db.Uuid
  orderId              String           @unique @db.Uuid
  order                Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status               SettlementStatus @default(PENDING)
  riderPayableMinor    Int              @default(0)
  merchantPayableMinor Int              @default(0)
  platformRevenueMinor Int              @default(0)
  finalizedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model RiderSettlement {
  id                      String                   @id @default(uuid()) @db.Uuid
  orderId                 String                   @unique @db.Uuid
  order                   Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId                 String                   @db.Uuid
  rider                   Rider                    @relation(fields: [riderId], references: [id])
  amountMinor             Int
  status                  RiderSettlementStatus    @default(PENDING)
  pendingUntil            DateTime
  availableAt             DateTime?
  heldAt                  DateTime?
  holdReason              String?
  reservedMinor           Int                      @default(0)
  compensationAllocations CompensationAllocation[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([riderId, status, pendingUntil])
}

model VerificationCode {
  id            String              @id @default(uuid()) @db.Uuid
  orderId       String              @db.Uuid
  order         Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  purpose       VerificationPurpose
  salt          String
  codeHash      String
  issuerId      String              @db.Uuid
  issuer        User                @relation("VerificationIssuer", fields: [issuerId], references: [id])
  verifierId    String?             @db.Uuid
  verifier      User?               @relation("VerificationVerifier", fields: [verifierId], references: [id])
  expiresAt     DateTime
  verifiedAt    DateTime?
  invalidatedAt DateTime?
  createdAt     DateTime            @default(now())

  @@index([orderId, purpose, createdAt])
}

model Evidence {
  id               String          @id @default(uuid()) @db.Uuid
  orderId          String          @db.Uuid
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actorId          String          @db.Uuid
  actor            User            @relation(fields: [actorId], references: [id])
  actorRole        UserRole
  evidenceType     EvidenceType
  orderStage       OrderStatus
  mediaReference   String?
  note             String?
  metadata         Json?
  exceptionEventId String?         @db.Uuid
  exceptionEvent   ExceptionEvent? @relation(fields: [exceptionEventId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())

  @@index([orderId, createdAt])
  @@index([exceptionEventId])
}

model ExceptionEvent {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @db.Uuid
  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reporterId    String         @db.Uuid
  reporter      User           @relation("ExceptionReporter", fields: [reporterId], references: [id])
  reporterRole  UserRole
  orderStatus   OrderStatus
  type          ExceptionType
  description   String
  evidences     Evidence[]
  exceptionCase ExceptionCase?
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([orderId, createdAt])
  @@index([type, resolvedAt])
}

model AdminProfile {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @unique @db.Uuid
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  level     AdminLevel @default(OPERATOR)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model AdminProfileAudit {
  id            String      @id @default(uuid()) @db.Uuid
  targetUserId  String      @db.Uuid
  targetUser    User        @relation("AdminProfileAuditTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  actorId       String      @db.Uuid
  actor         User        @relation("AdminProfileAuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  previousLevel AdminLevel?
  newLevel      AdminLevel
  reason        String
  createdAt     DateTime    @default(now())

  @@index([targetUserId, createdAt])
}

model RiderCancellationEvent {
  id            String                  @id @default(uuid()) @db.Uuid
  riderId       String                  @db.Uuid
  rider         Rider                   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  taskId        String                  @db.Uuid
  task          DeliveryTask            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  orderId       String                  @db.Uuid
  order         Order                   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignmentId  String                  @db.Uuid
  assignment    DeliveryAssignment      @relation(fields: [assignmentId], references: [id], onDelete: Restrict)
  reason        RiderCancellationReason
  note          String?
  campusDay     DateTime                @db.Date
  dailyCount    Int
  rollingCount  Int
  warningIssued Boolean                 @default(false)
  createdAt     DateTime                @default(now())

  @@unique([assignmentId])
  @@index([riderId, campusDay])
  @@index([riderId, createdAt])
}

model RiderRestriction {
  id         String                  @id @default(uuid()) @db.Uuid
  riderId    String                  @db.Uuid
  rider      Rider                   @relation(fields: [riderId], references: [id], onDelete: Cascade)
  type       RiderRestrictionType
  status     RiderRestrictionStatus  @default(ACTIVE)
  source     RiderRestrictionSource
  reason     String
  startsAt   DateTime
  endsAt     DateTime
  releasedAt DateTime?
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  audits     RiderRestrictionAudit[]

  @@index([riderId, status, endsAt])
}

model RiderRestrictionAudit {
  id             String                  @id @default(uuid()) @db.Uuid
  restrictionId  String                  @db.Uuid
  restriction    RiderRestriction        @relation(fields: [restrictionId], references: [id], onDelete: Cascade)
  actorId        String?                 @db.Uuid
  actor          User?                   @relation("RiderRestrictionAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  previousStatus RiderRestrictionStatus?
  newStatus      RiderRestrictionStatus
  previousEndsAt DateTime?
  newEndsAt      DateTime
  reason         String
  createdAt      DateTime                @default(now())

  @@index([restrictionId, createdAt])
}

model ExceptionCase {
  id                      String                   @id @default(uuid()) @db.Uuid
  orderId                 String                   @db.Uuid
  order                   Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  exceptionEventId        String                   @unique @db.Uuid
  exceptionEvent          ExceptionEvent           @relation(fields: [exceptionEventId], references: [id], onDelete: Cascade)
  category                ExceptionType
  subtype                 String?
  priority                ExceptionCasePriority    @default(UNKNOWN)
  status                  ExceptionCaseStatus      @default(OPEN)
  currentHandlerAdminId   String?                  @db.Uuid
  currentHandlerAdmin     User?                    @relation("ExceptionCaseHandler", fields: [currentHandlerAdminId], references: [id], onDelete: SetNull)
  claimedAt               DateTime?
  lastActionAt            DateTime                 @default(now())
  resolutionType          ExceptionResolutionType?
  resolutionNote          String?
  escalatedAt             DateTime?
  escalationReason        String?
  version                 Int                      @default(0)
  classifierSource        String?
  classifierVersion       String?
  classifierResult        Json?
  classifierConfidenceBps Int?
  actions                 ExceptionCaseAction[]
  remakeProposal          RemakeProposal?
  compensationObligation  CompensationObligation?
  createdAt               DateTime                 @default(now())
  resolvedAt              DateTime?

  @@index([status, priority, createdAt])
  @@index([currentHandlerAdminId, status])
  @@index([orderId, createdAt])
}

model ExceptionCaseAction {
  id                     String                  @id @default(uuid()) @db.Uuid
  caseId                 String                  @db.Uuid
  case                   ExceptionCase           @relation(fields: [caseId], references: [id], onDelete: Cascade)
  type                   ExceptionCaseActionType
  actorId                String?                 @db.Uuid
  actor                  User?                   @relation("ExceptionCaseActionActor", fields: [actorId], references: [id], onDelete: SetNull)
  previousHandlerAdminId String?                 @db.Uuid
  previousHandlerAdmin   User?                   @relation("ExceptionCasePreviousHandler", fields: [previousHandlerAdminId], references: [id], onDelete: SetNull)
  nextHandlerAdminId     String?                 @db.Uuid
  nextHandlerAdmin       User?                   @relation("ExceptionCaseNextHandler", fields: [nextHandlerAdminId], references: [id], onDelete: SetNull)
  reason                 String
  metadata               Json?
  createdAt              DateTime                @default(now())

  @@index([caseId, createdAt])
}

model RemakeProposal {
  id          String               @id @default(uuid()) @db.Uuid
  caseId      String               @unique @db.Uuid
  case        ExceptionCase        @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderId     String               @db.Uuid
  order       Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId     String               @db.Uuid
  rider       Rider                @relation(fields: [riderId], references: [id], onDelete: Restrict)
  message     String
  status      RemakeProposalStatus @default(PENDING)
  respondedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
}

model CompensationObligation {
  id                            String                   @id @default(uuid()) @db.Uuid
  caseId                        String                   @unique @db.Uuid
  case                          ExceptionCase            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  orderId                       String                   @db.Uuid
  order                         Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId                       String                   @db.Uuid
  rider                         Rider                    @relation(fields: [riderId], references: [id], onDelete: Restrict)
  requiredCompensationMinor     Int
  currentOrderReservedMinor     Int                      @default(0)
  otherUnwithdrawnReservedMinor Int                      @default(0)
  riderVoluntaryPaymentMinor    Int                      @default(0)
  platformAdvancedMinor         Int                      @default(0)
  customerRefundMinor           Int                      @default(0)
  outstandingMinor              Int                      @default(0)
  status                        CompensationStatus       @default(OPEN)
  idempotencyKey                String                   @unique
  releaseIdempotencyKey         String?                  @unique
  actorId                       String                   @db.Uuid
  actor                         User                     @relation("CompensationActor", fields: [actorId], references: [id], onDelete: Restrict)
  reason                        String
  allocations                   CompensationAllocation[]
  createdAt                     DateTime                 @default(now())
  updatedAt                     DateTime                 @updatedAt
  resolvedAt                    DateTime?
  releasedAt                    DateTime?
}

model CompensationAllocation {
  id                String                    @id @default(uuid()) @db.Uuid
  obligationId      String                    @db.Uuid
  obligation        CompensationObligation    @relation(fields: [obligationId], references: [id], onDelete: Cascade)
  source            CompensationFundingSource
  riderSettlementId String?                   @db.Uuid
  riderSettlement   RiderSettlement?          @relation(fields: [riderSettlementId], references: [id], onDelete: Restrict)
  amountMinor       Int
  releasedAt        DateTime?
  createdAt         DateTime                  @default(now())

  @@unique([obligationId, riderSettlementId, source], map: "CompensationAllocation_obligation_settlement_source_key")
  @@index([obligationId, createdAt])
  @@index([riderSettlementId])
}

model MerchantSubsidyAccount {
  id                String   @id @default(uuid()) @db.Uuid
  merchantId        String   @unique @db.Uuid
  merchant          Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  subsidyUsedMinor  Int      @default(0)
  subsidyLimitMinor Int      @default(0)
  subsidyUsageBps   Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MerchantExposureDecision {
  id              String                 @id @default(uuid()) @db.Uuid
  merchantId      String                 @db.Uuid
  merchant        Merchant               @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  previousState   MerchantExposureState
  newState        MerchantExposureState
  timeRisk        MerchantTimeRisk
  completionRisk  MerchantCompletionRisk
  policyVersion   Int
  reason          String
  metricsSnapshot Json
  actorId         String?                @db.Uuid
  actor           User?                  @relation("MerchantExposureDecisionActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt       DateTime               @default(now())

  @@index([merchantId, createdAt])
}

model MerchantDeliveryQuote {
  id            String   @id @default(uuid()) @db.Uuid
  orderId       String   @db.Uuid
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  version       Int
  previousMinor Int
  newMinor      Int
  operatorId    String   @db.Uuid
  operator      User     @relation("MerchantQuoteOperator", fields: [operatorId], references: [id])
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([orderId, version])
  @@index([orderId, createdAt])
}

model RiderTipEvent {
  id                   String              @id @default(uuid()) @db.Uuid
  orderId              String              @db.Uuid
  order                Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId           String              @db.Uuid
  customer             User                @relation("RiderTipCustomer", fields: [customerId], references: [id])
  deliveryAssignmentId String?             @db.Uuid
  deliveryAssignment   DeliveryAssignment? @relation(fields: [deliveryAssignmentId], references: [id], onDelete: SetNull)
  type                 RiderTipEventType
  deltaMinor           Int
  balanceAfterMinor    Int
  reason               String?
  createdAt            DateTime            @default(now())

  @@index([orderId, createdAt])
  @@index([deliveryAssignmentId])
}

model SubsidyRecord {
  id                           String   @id @default(uuid()) @db.Uuid
  merchantId                   String   @db.Uuid
  merchant                     Merchant @relation(fields: [merchantId], references: [id])
  orderId                      String   @db.Uuid
  order                        Order    @relation(fields: [orderId], references: [id])
  previousPlatformSubsidyMinor Int
  addedMinor                   Int
  newPlatformSubsidyMinor      Int
  policyVersion                Int
  trigger                      String
  createdAt                    DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([merchantId, createdAt])
}

model BusinessConfigAudit {
  id              String   @id @default(uuid()) @db.Uuid
  key             String
  previousVersion Int?
  newVersion      Int
  actorId         String   @db.Uuid
  actor           User     @relation("BusinessConfigAuditActor", fields: [actorId], references: [id])
  beforePayload   Json?
  afterPayload    Json
  reason          String
  createdAt       DateTime @default(now())

  @@index([key, createdAt])
}

model BusinessConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String
  version   Int
  isActive  Boolean  @default(true)
  payload   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, version])
  @@index([key, isActive, version])
}
